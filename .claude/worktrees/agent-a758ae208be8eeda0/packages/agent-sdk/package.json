{
  "name": "@devlaunch/agent-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Shared agent contract (AgentDefinition/AgentRunRequest/AgentRunResult) and AgentRegistry used by apps/api and apps/worker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "rimraf": "6.0.1",
    "vitest": "2.1.8"
  }
}
