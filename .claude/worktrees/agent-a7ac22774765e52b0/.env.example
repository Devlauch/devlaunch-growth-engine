# Copy to .env and edit for your local setup. ALL VALUES BELOW ARE
# PLACEHOLDERS — never commit real secrets here or anywhere in this repo.

NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=devlaunch
POSTGRES_PASSWORD=devlaunch
POSTGRES_DB=devlaunch_dev
POSTGRES_PORT=5432
# Full connection string used directly by apps/api, apps/worker, packages/db
DATABASE_URL=postgres://devlaunch:devlaunch@localhost:5432/devlaunch_dev

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- apps/api ---
API_PORT=4000
# DEV ONLY: enables the X-Dev-User-Id header auth bypass. MUST be "false"
# (with real JWT auth only) before any shared/production deployment.
ALLOW_DEV_AUTH=true
# Replace with long random values before anything beyond local dev.
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Public lead-capture widget rate limits
PUBLIC_LEADS_RATE_LIMIT_PER_IP_PER_MIN=10
PUBLIC_LEADS_RATE_LIMIT_PER_KEY_PER_MIN=60

# --- apps/dashboard (placeholder) ---
DASHBOARD_PORT=3000

# --- apps/worker ---
WORKER_CONCURRENCY=5
