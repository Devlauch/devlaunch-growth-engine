{
  "name": "@devlaunch/db",
  "version": "0.1.0",
  "private": true,
  "description": "DevLaunch Growth Engine - PostgreSQL schema and migrations (Phase 1)",
  "scripts": {
    "migrate": "node-pg-migrate -m migrations --migration-file-language sql",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:redo": "npm run migrate -- redo",
    "migrate:create": "npm run migrate -- create --",
    "db:seed": "node ./scripts/seed.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.1"
  }
}
