# Copy to .env.chatwoot and fill in before running:
#   docker compose -f docker-compose.yml -f docker-compose.chatwoot.yml --profile chatwoot up -d
#
# --- Chatwoot's own service (docker-compose.chatwoot.yml) ---

# Required. Generate with: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=

# Public URL Chatwoot itself thinks it's served from (used in emails,
# widget script src, etc.) — change for anything beyond local dev.
CHATWOOT_FRONTEND_URL=http://localhost:3200
CHATWOOT_PORT=3200

CHATWOOT_POSTGRES_USER=chatwoot
CHATWOOT_POSTGRES_PASSWORD=chatwoot
CHATWOOT_POSTGRES_DB=chatwoot_production

# Keep false unless you intentionally want Chatwoot's own public sign-up
# page reachable — platform connects to an account you create once via
# the setup wizard, not via self-serve sign-up.
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=false

# --- This platform's own apps/api process (NOT read by docker-compose.chatwoot.yml;
# set these in apps/api's own environment / docker-compose.yml's `api` service
# env block, or your shell, before connecting a tenant) ---

# Optional single-shared-account fallback, used only when a tenant/project
# hasn't connected its own per-tenant credential yet (see
# apps/api/src/lib/chatwootClient.ts's getChatwootClientForTenant).
CHATWOOT_BASE_URL=http://localhost:3200
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=

# Required for apps/api/src/routes/chatwootWebhooks.ts to accept ANY
# inbound AgentBot webhook delivery — must match the `secret` you set on
# the Chatwoot side's Agent Bot (Settings > Integrations > Agent Bots).
# With this unset, the webhook endpoint returns 503 for every request
# rather than silently accepting unauthenticated events.
CHATWOOT_WEBHOOK_SECRET=
