# Env vars for docker-compose.listmonk.yml (Milestone 2, Agent B — the
# Listmonk integration). Copy to .env.listmonk and fill in real values:
#   cp .env.listmonk.example .env.listmonk
#
# Then launch the opt-in `listmonk` profile ALONGSIDE the main stack so
# both Compose files share one project/network:
#   docker compose -f docker-compose.yml -f docker-compose.listmonk.yml \
#     --env-file .env.listmonk --profile listmonk up -d listmonk-db listmonk
#
# None of this is a platform API credential — these only configure the
# listmonk CONTAINER itself. The actual listmonk API key platform uses to
# call it is entered separately, per-project, via the dashboard's Listmonk
# integration page (POST .../integrations/listmonk/connect) and stored
# AES-256-GCM encrypted in Postgres (see
# apps/api/src/lib/credentialEncryption.ts) — never in this file, never in
# an env var the API process reads.

# --- Listmonk's own Postgres database (own container, not platform's) ---
LISTMONK_DB_USER=listmonk
LISTMONK_DB_PASSWORD=change-me-to-a-real-password
LISTMONK_DB_NAME=listmonk

# --- Listmonk app container ---
# Host port the listmonk admin UI / REST API is exposed on.
LISTMONK_PORT=9000

# Only set these for the VERY FIRST `docker compose up` against an empty
# database — listmonk uses them once to auto-create its Super Admin user.
# Leave blank to instead create the admin user via the web UI on first
# visit to http://localhost:9000.
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_PASSWORD=

# After listmonk is running, create a dedicated API user (Settings ->
# Users, or reuse the Super Admin) and generate an API key there — paste
# THAT (not anything in this file) into the dashboard's "Connect Listmonk"
# form (baseUrl / apiUser / apiKey). If you plan to point SendGrid's Event
# Webhook at this platform (see apps/api/src/routes/listmonkWebhooks.ts),
# also paste SendGrid's base64 DER verification public key into that same
# form — there is no env var for it; it is stored encrypted per-project
# alongside the API key.
