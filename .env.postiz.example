# .env.postiz.example — copy to .env.postiz and fill in before running
# `docker compose -f docker-compose.postiz.yml --env-file .env.postiz up -d`.
#
# This configures the STANDALONE Postiz service stack (its own Postgres,
# Redis, and Temporal cluster — see docker-compose.postiz.yml's header
# comment for the full honest operational-cost breakdown). It is entirely
# separate from platform's own .env — platform's api/worker processes talk
# to this running Postiz instance only over its `/public/v1` HTTP API (see
# apps/api/src/lib/postizClient.ts), never by sharing a database/process.

# Required — generate with `openssl rand -hex 32` or similar. Used by
# Postiz internally (JWT signing for its own dashboard sessions); this
# platform never reads or needs this value.
POSTIZ_JWT_SECRET=

# Where Postiz itself is reachable (its own dashboard + API), e.g.
# http://localhost:5000 for local dev, or your real deployed URL.
POSTIZ_MAIN_URL=http://localhost:5000
POSTIZ_BACKEND_URL=http://localhost:5000/api
POSTIZ_PORT=5000

# Postiz's own Postgres credentials (its database, not platform's).
POSTIZ_DB_USER=postiz
POSTIZ_DB_PASSWORD=change-me
POSTIZ_DB_NAME=postiz

# Temporal's own Postgres password.
POSTIZ_TEMPORAL_DB_PASSWORD=change-me
POSTIZ_TEMPORAL_PORT=7233

POSTIZ_DISABLE_REGISTRATION=false
POSTIZ_API_LIMIT=30

# Per-social-network OAuth app credentials. Each is a REAL developer-app
# registration you create on that network's own developer portal — Postiz
# cannot connect a network without one, and registration/review can take
# days to weeks per network (see docker-compose.postiz.yml's cost comment).
# Leave any of these blank to simply not offer that network yet.
POSTIZ_X_API_KEY=
POSTIZ_X_API_SECRET=
POSTIZ_LINKEDIN_CLIENT_ID=
POSTIZ_LINKEDIN_CLIENT_SECRET=
POSTIZ_FACEBOOK_APP_ID=
POSTIZ_FACEBOOK_APP_SECRET=

# ---------------------------------------------------------------------------
# Platform-side (apps/api) config — these go in platform's OWN .env, not
# .env.postiz, listed here for convenience since they're this integration's:
# ---------------------------------------------------------------------------
#
# POSTIZ_BASE_URL=http://localhost:5000   # same value as POSTIZ_MAIN_URL above
# POSTIZ_API_KEY=                         # a single shared-org API key, ONLY
#                                          # for a dev/test fallback — real
#                                          # tenants connect their own Postiz
#                                          # Organization's own API key via
#                                          # POST .../integrations/postiz/connect
#                                          # instead (stored encrypted, see
#                                          # apps/api/src/lib/credentialEncryption.ts)
# POSTIZ_WEBHOOK_SECRET=                  # this platform's own shared secret
#                                          # for the best-effort webhook
#                                          # receiver — see
#                                          # apps/api/src/routes/postizWebhooks.ts's
#                                          # doc comment for why this is
#                                          # advisory-only (Postiz's public API
#                                          # documents no signature scheme)
