{
  "name": "@devlaunch/worker",
  "version": "0.1.0",
  "private": true,
  "description": "DevLaunch Growth Engine - Redis/BullMQ worker process that executes queued agent runs (Phase 1).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@devlaunch/agent-sdk": "*",
    "bullmq": "5.34.2",
    "ioredis": "5.4.2",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "typescript": "5.7.3",
    "tsx": "4.19.2",
    "rimraf": "6.0.1",
    "vitest": "2.1.8"
  }
}
