{
  "name": "@devlaunch/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "DevLaunch Growth Engine - Phase 1 dashboard UI (Vite + React + TypeScript). Talks to the Express API in apps/api.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 3000 --host",
    "start": "node serve.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "recharts": "2.15.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "rimraf": "6.0.1"
  }
}
